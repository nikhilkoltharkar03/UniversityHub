# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/university_hub?retryWrites=true&w=majority

# Cloudflare R2 Storage (Direct S3-Compatible Uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=university-hub-projects
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Security & Encryption (AES-256)
AES_SECRET_KEY=your_aes_secret_key_32_characters_minimum

# Google Gemini AI (@google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key

